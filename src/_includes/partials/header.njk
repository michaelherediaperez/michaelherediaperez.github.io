<header class="site-header">
  <div class="header-inner">
    <a class="site-title" href="/{{ lang }}/">{{ site.title }}</a>

    <nav class="main-nav" aria-label="Navegación principal">
      <ul>
        {% for item in nav[lang] %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <nav class="lang-switch" aria-label="Selector de idioma">
      {% for l in site.languages %}<a href="{{ l.url }}"{% if l.code == lang %} class="active" aria-current="true"{% endif %}>{{ l.label }}</a>{% endfor %}
    </nav>
  </div>
</header>
